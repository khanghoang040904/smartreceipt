# SmartReceipt Environment Variables
# Copy this file to .env and fill in your values

# Gemini API Key (required for OCR and chatbot)
# Get it from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-api-key-here

# Gemini Model (optional, default: gemini-2.0-flash)
# Available: gemini-2.0-flash, gemini-2.5-flash, gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-2.0-flash

# Database URL (optional, default: SQLite)
# DATABASE_URL=sqlite:///./smartreceipt.db

# JWT Secret Key (change in production)
# SECRET_KEY=your-secret-key
